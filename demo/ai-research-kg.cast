[33.574774, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mp:Problem\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:HAS_NEXT_EXPERIMENT\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mf:F\u001b[0m\u001b[33mutureDirection\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE p.status = \u001b[0m\u001b[33m'open'\u001b[0m\u001b[33m AND \u001b[0m\r\n\u001b[33mf.single_machine = true RETURN p.title AS problem, f.compute_budget_gpu_hours AS gpu_hours ORDER BY \u001b[0m\r\n\u001b[33mgpu_hours ASC LIMIT \u001b[0m\u001b[1;33m10\u001b[0m\r\n"]
